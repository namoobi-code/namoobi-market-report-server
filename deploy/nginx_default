server {
    if ($host = namoobi.duckdns.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80 default_server;
    server_name namoobi.duckdns.org _;
    include /etc/nginx/snippets/nmr_common.conf;


}

server {
    listen 443 ssl http2 default_server;
    server_name namoobi.duckdns.org _;
    ssl_certificate /etc/letsencrypt/live/namoobi.duckdns.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/namoobi.duckdns.org/privkey.pem; # managed by Certbot
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:5m;

    include /etc/nginx/snippets/nmr_common.conf;

}
